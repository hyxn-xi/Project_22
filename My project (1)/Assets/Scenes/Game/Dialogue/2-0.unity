--- !u!114 &1850202395
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1850202392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83dc85c641297d044a016efd6949ba28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  girlUI: {fileID: 333001248}
  girlText: {fileID: 285663421}
  dadUI: {fileID: 170138988}
  dadText: {fileID: 1639844144}
  lines:
  - text: "\uB2E4\uB9AC\uAC00 \uB04A\uC5B4\uC838\uC788\uC5B4 ... \uC2DC\uAC04\uC774
      \uBA48\uCD98 \uAC83 \uAC19\uC544."
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: fb9c9fe830797f6428753eba4277c883, type: 3}
  - text: "\uC800\uAE30 ... \uAD1C\uCC2E\uC73C\uC138\uC694?"
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: 6b84de1831b1bae43ade94f5a1785b9c, type: 3}
  - text: ".. \uC5B4? \uB108\uB294 \uB204\uAD6C\uB2C8 ...?"
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  - text: "\uC800\uB294 \uADF8\uB0E5, \uAE38\uC744 \uC783\uC740 \uC544\uC774\uC5D0\uC694.\n\uC544\uC90C\uB9C8\uAC00
      \uB108\uBB34 \uC2AC\uD37C\uBCF4\uC5EC\uC11C ..."
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: fb9c9fe830797f6428753eba4277c883, type: 3}
  - text: "... \uB9E4\uC77C \uC544\uCE68\uC774 \uB450\uB824\uC6CC.\n\uB9C8\uC74C\uC774
      \uCC22\uC5B4\uC838 \uC788\uB294 \uAC83 \uAC19\uC544."
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  - text: "\uB9C8\uC74C\uC774\uC694 ...?"
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: 6b84de1831b1bae43ade94f5a1785b9c, type: 3}
  - text: "\uADF8 \uC77C\uC774 \uC788\uACE0 \uB09C \uD6C4 ...\n\uC544\uBB34\uAC83\uB3C4
      \uC81C\uC790\uB9AC\uC5D0 \uC788\uC9C0 \uC54A\uC544 ..."
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  - text: "\uC2DC\uAC04\uB3C4, \uB9C8\uC74C\uB3C4, \uAC00\uC871\uB4E4\uB3C4 ..."
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  - text: "\uADF8 \uC77C\uC774\uC694...?\n\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB098\uC694?"
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: 6b84de1831b1bae43ade94f5a1785b9c, type: 3}
  - text: "\uAC00\uC871\uB4E4\uACFC \uD658\uD558\uAC8C \uC6C3\uC73C\uBA74\uC11C \uC9C0\uB0B4\uB358
      \uC2DC\uAC04\uB4E4\uC774 \uC788\uC5C8\uC5B4...\n\uC774\uC820 \uC544\uB2C8\uC9C0\uB9CC."
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  - text: "... \uB2E4\uC2DC \uAC00\uC871\uB4E4\uACFC \uD658\uD558\uAC8C \uC6C3\uC73C\uBA74\uC11C\n\uC9C0\uB0B4\uACE0
      \uC2F6\uC73C\uC2E0 \uAC70\uC5D0\uC694?"
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: fb9c9fe830797f6428753eba4277c883, type: 3}
  - text: "\uD558\uC9C0\uB9CC ... \uC6C3\uB294 \uBC95\uC744 \uC78A\uC5B4\uBC84\uB838\uC5B4.\n\uC6B0\uB9AC\uC758
      \uC2DC\uAC04\uC740 \uB354 \uC774\uC0C1 \uD750\uB974\uC9C0 \uC54A\uC544 ..."
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  - text: "\uC800\uAE30 ... \uBE5B\uB098\uB294 \uACF3\uC73C\uB85C \uAC19\uC774 \uAC00\uBD10\uC694."
    speakerName: Girl
    isLeftSide: 1
    portrait: {fileID: 21300000, guid: 6b84de1831b1bae43ade94f5a1785b9c, type: 3}
  - text: "\uC800\uAC74 ...?"
    speakerName: Dad
    isLeftSide: 0
    portrait: {fileID: 21300000, guid: a97fd0e1ac566ac488eb5da64f0de750, type: 3}
  typingSpeed: 0.05
  portraitFront: {fileID: 99544114}
  portraitBack: {fileID: 415073083}
